---
import Project from "../components/Project.astro";
import FooterSignup from "../components/FooterSignup.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const games = (await getCollection("projects")).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);
---

<Layout>
  <header>
    <div class="container">
      <h1>Don't Expect Anything Sensible</h1>

      <p>Making games <strike>since 2014</strike> for absolutely ages</p>
    </div>
  </header>

  <main>
    <div class="container">
      <ul>
        {games.map((game) => <Project {...game.data} />)}
      </ul>
    </div>
  </main>

  <footer>
    <div class="container">
      <h3>Don't Expect Anything Sensible</h3>

      <p>Keep up to date with us by signing up below</p>
      <FooterSignup />
    </div>
  </footer>
</Layout>

<style>
  body {
    background-color: #54c22d;
    font-size: 1rem;
    font-family:
      "Futura", "Gill Sans", "Gill Sans MT", Calibri, "Trebuchet MS", sans-serif;
  }

  footer {
    background-color: #63490f;
    padding: 1rem 0;
  }

  .container {
    max-width: 960px;
    margin: auto;
  }
</style>
