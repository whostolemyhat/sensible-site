---
interface Props {
  title: string;
  img: string;
  description: string;
  link: string;
  date: string;
}
const { title, description, img, link, date } = Astro.props;
---

<div class="project">
  {
    img && (
      <a href={link} title={`Visit ${title}`} class="project__image_link">
        <div
          title={`View ${title}`}
          class="project__image"
          aria-label={title}
          role="img"
          style={`background-image: url(${img})`}
        />
      </a>
    )
  }
  <div>
    <h2><a class="project__link" href={link} title={title}>{title}</a></h2>
    <!-- <time datetime={date} class="project__date"
      >{new Date(date).getFullYear()}</time
    > -->
    <p class="project__description" set:html={description} />
    <a class="button" href={link} title={`Visit ${title} site`}>Take a look</a>
  </div>
</div>

<style>
  .project__image {
    flex-shrink: 0;
    height: 270px;
    width: 220px;
    background-color: var(--white);
    background-size: 105%;
    background-position: center;
    margin: auto;
    /* // https: //bennettfeely.com/clippy/ */
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);

    @media (min-width: 700px) {
      margin-right: 2.4rem;
    }
  }

  .project {
    width: 100%;
    max-width: 720px;
    padding: 1rem 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    text-align: center;
    margin-bottom: 1.6rem;

    @media (min-width: 700px) {
      flex-direction: row;
      text-align: initial;
      margin-bottom: 0;
    }
  }

  /* .project:nth-child(even) {
    @media (min-width: 700px) {
      flex-direction: row-reverse;
      justify-content: space-between;

      .project__image {
        margin: 0 0 0 2.4rem;
      }
    }
  } */

  h2 {
    margin-bottom: 0.4rem;

    @media (max-width: 500px) {
      margin-top: 0.8rem;
      text-align: center;
    }
  }

  .project__description {
    margin-top: 0.8rem;
  }

  .project .button {
    margin-left: 0;
  }

  .project__date {
    font-size: 1.2rem;
    margin: 0;
  }

  .project__link,
  .project__link:visited {
    color: var(--white);

    &:hover {
      color: var(--pink);
      background-color: transparent;
    }
  }

  .project__image_link {
    &:hover {
      background-color: transparent;
    }
  }
</style>
